#!/usr/bin/env bash
# Blocks a commit that would add owner data or a secret. Installed by bin/install-hooks.sh
# (git config core.hooksPath .githooks). CI repeats both checks, so skipping this hook only delays the failure.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
node bin/check-public.mjs --staged
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact --config .gitleaks.toml
else
  echo "✗ gitleaks is not installed — install it (brew install gitleaks) so secrets are caught before they are committed." >&2
  exit 1
fi
