{
  "space": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "xxs": {
      "$type": "dimension",
      "$value": "2px"
    },
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "xxxl": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "xxl": {
        "$type": "dimension",
        "$value": "24px"
      },
      "display": {
        "$type": "dimension",
        "$value": "32px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      }
    }
  },
  "icon": {
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "16px"
      },
      "md": {
        "$type": "dimension",
        "$value": "20px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "24px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "32px"
      }
    }
  },
  "elevation": {
    "level0": {
      "$type": "number",
      "$value": 0
    },
    "level1": {
      "$type": "number",
      "$value": 1
    },
    "level2": {
      "$type": "number",
      "$value": 3
    },
    "level3": {
      "$type": "number",
      "$value": 6
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "normal": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      }
    }
  },
  "breakpoint": {
    "compact": {
      "$type": "dimension",
      "$value": "0px"
    },
    "medium": {
      "$type": "dimension",
      "$value": "600px"
    },
    "expanded": {
      "$type": "dimension",
      "$value": "840px"
    },
    "large": {
      "$type": "dimension",
      "$value": "1200px"
    }
