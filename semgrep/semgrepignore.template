.dart_tool/
.venv/
Pods/
vendor/
coverage/
*.min.js
*.g.dart
*.freezed.dart
*.gen.dart
*.pb.go
*_generated.*
# Flutter/native platform shells (boilerplate, not app code)
ios/Runner/
macos/Runner/
android/app/src/main/
# Generated web workers / bundles
web/*_worker.js
