        "cited": "LLM Top 10 2026; Agentic Top 10 2026",
        "kind": "default",
        "url": "https://genai.owasp.org/"
      },
      {
        "id": "owasp-masvs",
        "name": "OWASP MASVS",
        "cited": "see REFERENCES.md",
        "kind": "default",
        "url": "https://mas.owasp.org/MASVS/"
      },
      {
        "id": "nist-800-63",
        "name": "NIST SP 800-63",
        "cited": "4",
